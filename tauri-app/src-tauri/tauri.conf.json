{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/tauri-v2/main/schema/tauri.conf.json",
  "productName": "CPDR 抓娃娃机",
  "version": "1.0.0",
  "identifier": "com.cpdr.claw-machine",
  "build": {
    "beforeDevCommand": "npx http-server src -p 1420 --cors -c-1 -s",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "CPDR 抓娃娃机控制系统",
        "width": 830,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
